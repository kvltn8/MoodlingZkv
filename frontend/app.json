{
  "expo": {
    "name": "Moodling",
    "slug": "moodling",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moodling",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodling.app"
    },
    "android": {
      "package": "com.moodling.app"
    }
  }
}
